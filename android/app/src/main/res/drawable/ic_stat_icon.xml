<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: orbit arcs + checkmark (matches the app icon).
     Must stay white-on-transparent — the status bar only uses the alpha
     channel and tints it with the LocalNotifications iconColor. The arcs and
     their dot terminals are drawn at ~54% alpha so they read as gray stripes
     around the solid checkmark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- outer arc: top -> down the left side -->
    <path
        android:pathData="M13.42,3.92 A8.2,8.2 0 0 0 6.95,18.46"
        android:strokeColor="#8AFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />
    <!-- inner arc: upper-left -> right -->
    <path
        android:pathData="M7.15,9.2 A5.6,5.6 0 0 1 17.08,9.63"
        android:strokeColor="#8AFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />
    <!-- short arc on the right -->
    <path
        android:pathData="M19.8,12 A7.8,7.8 0 0 1 17.8,17.22"
        android:strokeColor="#8AFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />
    <!-- short arc along the bottom -->
    <path
        android:pathData="M14.6,19.14 A7.6,7.6 0 0 1 9.65,19.23"
        android:strokeColor="#8AFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />

    <!-- arc terminals -->
    <path
        android:pathData="M11.87,3.92a1.55,1.55 0 1 0 3.1,0a1.55,1.55 0 1 0 -3.1,0Z"
        android:fillColor="#8AFFFFFF" />
    <path
        android:pathData="M15.68,9.63a1.4,1.4 0 1 0 2.8,0a1.4,1.4 0 1 0 -2.8,0Z"
        android:fillColor="#8AFFFFFF" />
    <path
        android:pathData="M16.4,17.22a1.4,1.4 0 1 0 2.8,0a1.4,1.4 0 1 0 -2.8,0Z"
        android:fillColor="#8AFFFFFF" />
    <path
        android:pathData="M8.25,19.23a1.4,1.4 0 1 0 2.8,0a1.4,1.4 0 1 0 -2.8,0Z"
        android:fillColor="#8AFFFFFF" />

    <!-- checkmark, full opacity so the mark stays readable at status-bar size -->
    <path
        android:pathData="M8.8,12.6L11.1,14.9L14.3,10.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
