<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: orbit ring + check (matches logo.svg). Must stay
     white-on-transparent — the status bar only uses the alpha channel and
     tints it with the LocalNotifications iconColor. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Orbit ring, broken into two arcs with rounded dot terminals -->
    <path
        android:pathData="M17.16,4.63 A9.00,9.00 0 0,0 6.84,19.37"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M17.16,4.63 m-1.65,0 a1.65,1.65 0 1,0 3.30,0 a1.65,1.65 0 1,0 -3.30,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M19.95,7.77 A9.00,9.00 0 0,1 9.52,20.65"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M9.52,20.65 m-1.65,0 a1.65,1.65 0 1,0 3.30,0 a1.65,1.65 0 1,0 -3.30,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Check mark -->
    <path
        android:pathData="M8.95,12.30 L11.00,14.45 L15.05,10.10"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
