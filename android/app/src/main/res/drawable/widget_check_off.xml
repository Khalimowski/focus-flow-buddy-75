<?xml version="1.0" encoding="utf-8"?>
<!-- Unticked bullet. Drawn hairline and colourless; TaskWidgetProvider tints
     the stroke per theme with setColorFilter, the way the app's task rows use
     a plain border-coloured ring rather than a coloured control. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#00000000" />
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFF" />
    <size
        android:width="19dp"
        android:height="19dp" />
</shape>
