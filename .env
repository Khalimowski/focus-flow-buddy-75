# Public client-side URLs for Neon Auth + Data API (safe to commit — no secrets).
# Access is controlled by user JWTs and Postgres row-level security.
VITE_NEON_AUTH_URL=https://ep-square-tree-asb1wx01.neonauth.c-4.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-square-tree-asb1wx01.apirest.c-4.eu-central-1.aws.neon.tech/neondb/rest/v1

# Google integrations (Gmail import / Calendar sync). Public OAuth client id —
# safe to commit. Leave empty to hide the feature. Setup steps: src/lib/google.ts
VITE_GOOGLE_WEB_CLIENT_ID=857809018966-n5uqa0pbb58ri205chl9bkdl01cb3521.apps.googleusercontent.com

# Premium: link mailed to customers and opened by the "Browser version" button.
VITE_WEB_APP_URL=https://flowday.day/

# Optional unlock service (workers/premium-unlock/). Empty = purchases are
# trusted client-side and no welcome email is sent; the entitlement still syncs.
VITE_PREMIUM_UNLOCK_URL=

# Set to "false" to let the browser build run without premium (demo deploys).
VITE_PREMIUM_WEB_GATE=true
